# URL pública del sitio (sin diagonal final). Se usa en metadatos, sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=https://mirai-nexus.vercel.app

# WhatsApp comercial en formato internacional sin "+" ni espacios (ej. 5214421234567).
# Si no se define, se usa el número configurado en src/content/site.ts.
NEXT_PUBLIC_WHATSAPP_NUMBER=525660548768

# Destino de las solicitudes del formulario de contacto.
# Recomendado: Gmail por SMTP con una «contraseña de aplicación» (myaccount.google.com → Seguridad → Contraseñas de aplicaciones).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=          # tu cuenta de Gmail
SMTP_PASS=          # la contraseña de aplicación (16 letras), no tu contraseña normal
# Correo que RECIBE las solicitudes. Solo se usa en el servidor: nunca aparece en la página.
CONTACT_TO_EMAIL=
# Opcional: "smtp" (por defecto si hay SMTP_USER), "webhook" (n8n, Make, Zapier, CRM) o "resend".
CONTACT_PROVIDER=
CONTACT_WEBHOOK_URL=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# Si no hay correo configurado, el formulario informa honestamente que el envío aún no está disponible.

