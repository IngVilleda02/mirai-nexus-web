# URL pública del sitio (sin diagonal final). Se usa en metadatos, sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=https://mirainexus.com

# WhatsApp comercial en formato internacional sin "+" ni espacios (ej. 5214421234567).
# Si se deja vacío, el botón de WhatsApp no se muestra.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Destino de las solicitudes del formulario de contacto.
# Elige UN proveedor: "webhook" (n8n, Make, Zapier, CRM) o "resend" (correo).
# Si no se configura, el formulario informa honestamente que el envío aún no está disponible.
CONTACT_PROVIDER=
CONTACT_WEBHOOK_URL=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
