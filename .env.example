# URL pública del sitio (sin diagonal final). Se usa en metadatos, sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=https://mirainexus.com

# WhatsApp comercial en formato internacional sin "+" ni espacios (ej. 5214421234567).
# Si no se define, se usa el número configurado en src/content/site.ts.
NEXT_PUBLIC_WHATSAPP_NUMBER=525660548768

# Destino de las solicitudes del formulario de contacto.
# Elige UN proveedor: "webhook" (n8n, Make, Zapier, CRM) o "resend" (correo).
# Si no se configura, el formulario informa honestamente que el envío aún no está disponible.
CONTACT_PROVIDER=
CONTACT_WEBHOOK_URL=
RESEND_API_KEY=
# Correo que RECIBE las solicitudes. Solo se usa en el servidor: nunca aparece en la página.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Panel de cotizaciones (MIRAI Panel), ej. https://panel.mirainexus.com
# Activa /admin → acceso del panel con el estilo de MIRAI NEXUS. Vacío = /admin no existe.
NEXT_PUBLIC_PANEL_URL=
